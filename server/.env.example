# انسخ هذا الملف باسم .env واملأ القيم الحقيقية — لا ترفع .env نفسه على GitHub أبدًا

# رابط الاتصال بقاعدة بيانات PostgreSQL (تحصل عليه من Neon أو Render أو أي مزوّد)
DATABASE_URL=postgresql://username:password@host:5432/database_name

# اتركه كما هو إلا إذا قاعدة بياناتك لا تدعم SSL
DATABASE_SSL=true

# مفتاح سري عشوائي طويل لتوقيع جلسات الدخول — غيّره لأي نص عشوائي طويل خاص بك
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_STRING

# المنفذ الذي يعمل عليه السيرفر
PORT=4000
